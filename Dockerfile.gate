FROM node:22.23.4-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN test ! -e vercel.json && test ! -e netlify.toml
RUN grep -Fx 'Hosting: Cloudflare only. Never Vercel or Netlify.' AGENTS.md
RUN --network=none npm run lint
RUN --network=none npm run build
RUN test -s dist/index.html && test -s dist/_headers && test -n "$(find dist/assets -type f -name '*.js' -print -quit)"
